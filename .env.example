MONGODB_URI=mongodb://localhost:27017/smart_segmentation
DB_NAME=smart_segmentation
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
