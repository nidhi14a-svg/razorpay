# ==============================================================================
# RAZZZ AI REVENUE AGENT - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# MongoDB Connection Configuration
# ------------------------------------------------------------------------------
# For Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/smart_segmentation
#
# For MongoDB Atlas (Production):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_segmentation?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/smart_segmentation

# Optional: Override database name if not specified in MONGODB_URI
DB_NAME=smart_segmentation

# ------------------------------------------------------------------------------
# Server & CORS Configuration
# ------------------------------------------------------------------------------
# Port for the FastAPI server (default: 8000, cloud providers often inject PORT)
PORT=8000

# Allowed CORS origins for frontend access (comma-separated). Use exact domains in production!
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend application URL (used in email verification & password reset links)
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# AI Engine Credentials (OpenRouter / OpenAI)
# ------------------------------------------------------------------------------
# Required for AI Campaign Intelligence and Strategy recommendations
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway Credentials
# ------------------------------------------------------------------------------
# Required for generating coupons, orders, and payment links
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key

# ------------------------------------------------------------------------------
# Authentication & Email Verification
# ------------------------------------------------------------------------------
# Set to 'false' for local testing and frictionless onboarding (recommended default)
# Set to 'true' only if you want to strictly require email verification before login
REQUIRE_EMAIL_VERIFICATION=false

# Auto-seed demo data on server startup if missing in database (useful for MongoDB Atlas on Render)
# Set to 'true' to ensure demo data (Summer Store / demo@example.com) is automatically seeded
AUTO_SEED_DEMO_DATA=false

# SMTP configuration for verification and notification emails
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
SENDER_EMAIL=your_email@gmail.com

# ------------------------------------------------------------------------------
# File Upload Limits
# ------------------------------------------------------------------------------
# Maximum file size per uploaded CSV file in megabytes (default: 50MB)
MAX_CSV_FILE_SIZE_MB=50
